;===========================================================================
; EWW WIDGETS ORCHESTRATOR
; Assembles all widgets/popups
;===========================================================================

(include "./widgets/calendar.yuck")
(include "./widgets/music.yuck")
(include "./widgets/sysinfo.yuck")

; --- Calendar Popup ---
; Shows calendar popup with interactive calendar.
; Currently aligned with waybars datetime component.
(defwindow calendar_popup
  :geometry (geometry
    :x "55px" :y "0px"
    :width "300px" :height "250px"
    :anchor "top right"
  )

  :reserve (struts :distance "250px" :side "top")

  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-popup"

  (calendar_layout)
)

; --- Music Popup ---
; Shows music popup with interactive music bar.
; Currently aligned to top-center of screen.
(defwindow music_bar
  :geometry (geometry
    :x "10px" :y "10px"
    :width "320px"
    :height "90px"
    :anchor "top center"
  )

  :stacking "fg"
  :windowtype "dialog"
  :exclusive false
  :focusable false
  :namespace "eww-popup"

  (media_player)
)

; --- System Information Popup ---
; Shows sysinfo popup with dynamic visuals of CPU, RAM, AND DISK utilization.
; Currently aligned with waybars utilization component.
(defwindow sysinfo_popup
  :geometry (geometry
    :x "150px" :y "10px"
    :width "240px"
    :anchor "top right"
  )

  :reserve (struts :distance "250px" :side "top")

  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-popup"

  (system_info)
)
