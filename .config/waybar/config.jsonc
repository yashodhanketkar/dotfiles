[
  {
    "name": "main",
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "spacing": 0,
    "height": 34,

    "include": [
      "./bars/top/left.json",
      "./bars/top/center.json",
      "./bars/top/right.json",
    ],
  },
  {
    "name": "side",
    "layer": "top",
    "position": "left",
    "reload_style_on_change": true,
    "include": ["./bars/side/center.json"],
  },
  {
    "name": "submap",
    "layer": "top",
    "mode": "overlay",
    "position": "bottom",
    "reload_style_on_change": true,
    "include": ["./bars/bottom/center.json"],
  },
]
